# Copy to .env; generate three independent secrets before use. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-generated-local-secret
PIN_HASH_PEPPER=replace-with-generated-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=done_together
DB_USER=done_together
DB_PASSWORD=replace-with-generated-local-secret
DB_HOST=127.0.0.1
DB_PORT=55432
TEST_DB_NAME=test_done_together
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=done-together@example.test
APP_BASE_URL=http://127.0.0.1:8000
